# Copy this file to .env.local and adjust. With XAMPP the defaults below usually work as they are.

# MySQL / MariaDB
DB_HOST=82.25.121.1
DB_PORT=3306
DB_USER=u390353841_villa_root
DB_PASSWORD=gasdfakfddasA23
DB_NAME=u390353841_villa_manage
# A "$" in any value (such as the password) must be written as "\$".
# Most connections each server copy may open. Use 2 or 3 on Vercel with a Hostinger database.
# DB_CONNECTION_LIMIT=10

# The first Super Admin account, created once when the database is empty.
SUPER_ADMIN_NAME=Platform Admin
SUPER_ADMIN_EMAIL=admin@villaplatform.lk
SUPER_ADMIN_PASSWORD=superadmin2026

# true: a new database is filled with four sample villas. Set to false for a clean production start.
SEED_DEMO=true

# "Today" is worked out in this time zone. Keep it the same as the villas' own time zone.
APP_TIMEZONE=Asia/Colombo

# Session cookies are sent over HTTPS only in production. Uncomment only to try a production build over plain http.
# COOKIE_SECURE=false

# The site's public address, used for the page Dodo sends people back to after paying,
# and for the links in emails (password reset, payment emails). Set it in production.
APP_URL=http://localhost:3000

# The public website, a separate project on its own domain (production: https://lankastay.com).
# Its Contact and waitlist forms may post here, and old links to /features, /pricing and so on go there.
# Built into the pages: build again after changing it.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Encrypts the SMTP password saved in Super Admin → Settings → Email. Any long random text,
# for example the output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it the same once set; if it changes, save the SMTP password again.
APP_SECRET=Kg0PRQP8ZHIuF374BubC0hpA5vr4ZpqI3vwQsMvjpfc=

# Dodo Payments (card payments for villa subscriptions). Leave empty to switch card payments off.
# API key: Dodo dashboard → Developer → API Keys. Webhook key: the signing key (whsec_...) of the
# webhook pointing to https://<your-site>/api/webhooks/dodo
DODO_PAYMENTS_API_KEY=dodo_test_JvHjyeKenK-tjQyc._PjZwHFNTZymiJuRJxZ7QS6x7vlM7Ho2iZOAx2sdfF1NGqbp
DODO_PAYMENTS_WEBHOOK_KEY=whsec_+NeybwqHNagM6h4BbRfeSi5ePJYij6WW
# test_mode or live_mode. Test and live keys are separate; use the keys of the mode set here.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Optional: links for the Terms box on the Register page (/register).
# NEXT_PUBLIC_TERMS_URL=https://example.com/terms
# NEXT_PUBLIC_PRIVACY_URL=https://example.com/privacy

# Protects the monthly report job (/api/cron/monthly-reports). Any long random text; set the same
# value in Vercel → Settings → Environment Variables and Vercel Cron sends it automatically.
CRON_SECRET=

# Uploaded receipts (expenses and bill payments) go to a DigitalOcean Space, privately.
# Leave the keys empty to switch uploads off. DO_ENDPOINT can be https://sfo3.digitaloceanspaces.com or the Space's own address.
DO_ACCESS_KEY_ID=
DO_SECRET_ACCESS_KEY=
DO_DEFAULT_REGION=sfo3
DO_SPACE=
DO_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_CDN_ENDPOINT=
# The folder inside the Space for this app's files (default Bills)
DO_FOLDER=Bills
